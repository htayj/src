#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${TMUX_SEND_LATER_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-send-later}"
JOBS_DIR="$STATE_DIR/jobs"

usage() {
  cat <<'USAGE'
tmux-send-later - schedule literal text to be sent to a tmux pane later

Usage:
  tmux-send-later schedule (--in DURATION | --at WHEN) [-t TARGET] [--no-enter] -- LINE
  tmux-send-later list [--all]
  tmux-send-later cancel <ID|all>
  tmux-send-later run <ID>
  tmux-send-later cleanup [--older-than DURATION]

Examples:
  tmux-send-later schedule --in 5m -t %7 -- make test
  tmux-send-later schedule --at 23:30 -t editor:1.0 -- 'echo done'
  tmux-send-later list
  tmux-send-later cancel tmux-abc123

WHEN supports ISO/date strings accepted by `date -d`, local HH:MM[:SS], epoch
seconds, or relative durations like +10s, 5m, 1h, 2d. DURATION accepts the
same relative duration syntax without calendar dates. Text is sent with
`tmux send-keys -l`, so it is literal, then Enter is sent unless --no-enter is
used. If TARGET is omitted, TMUX_PANE is used.
USAGE
}

err() {
  printf 'tmux-send-later: %s\n' "$*" >&2
}

ensure_dirs() {
  mkdir -p "$JOBS_DIR"
}

now_epoch() {
  date +%s
}

duration_to_seconds() {
  local input="$1" number unit
  if [[ "$input" =~ ^\+?([0-9]+)(ms|s|m|h|d)?$ ]]; then
    number="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]:-s}"
    case "$unit" in
      ms) printf '%s\n' $(( (number + 999) / 1000 )) ;;
      s) printf '%s\n' "$number" ;;
      m) printf '%s\n' $(( number * 60 )) ;;
      h) printf '%s\n' $(( number * 3600 )) ;;
      d) printf '%s\n' $(( number * 86400 )) ;;
      *) return 1 ;;
    esac
    return 0
  fi
  return 1
}

parse_when() {
  local input="$1" now target seconds
  now=$(now_epoch)

  if seconds=$(duration_to_seconds "$input" 2>/dev/null); then
    printf '%s\n' $(( now + seconds ))
    return 0
  fi

  if [[ "$input" =~ ^([0-9]{1,2}):([0-9]{2})(:([0-9]{2}))?$ ]]; then
    local hh="${BASH_REMATCH[1]}" mm="${BASH_REMATCH[2]}" ss="${BASH_REMATCH[4]:-0}"
    if (( 10#$hh > 23 || 10#$mm > 59 || 10#$ss > 59 )); then
      err "invalid time: $input"
      return 1
    fi
    target=$(date -d "today $hh:$mm:$ss" +%s)
    if (( target <= now )); then
      target=$(date -d "tomorrow $hh:$mm:$ss" +%s)
    fi
    printf '%s\n' "$target"
    return 0
  fi

  if [[ "$input" =~ ^[0-9]{10,}$ ]]; then
    if (( ${#input} >= 13 )); then
      printf '%s\n' "${input:0:${#input}-3}"
    else
      printf '%s\n' "$input"
    fi
    return 0
  fi

  date -d "$input" +%s 2>/dev/null || {
    err "could not parse time: $input"
    return 1
  }
}

shell_quote() {
  printf '%q' "$1"
}

new_id() {
  printf 'tmux-%s-%04x%04x\n' "$(date +%Y%m%d%H%M%S)" "$RANDOM" "$RANDOM"
}

write_job() {
  local job_file="$1" id="$2" target="$3" run_at="$4" enter="$5" status="$6" pid="$7" line_file="$8" created_at="$9" updated_at="${10}"
  cat >"$job_file" <<JOB
id=$(shell_quote "$id")
target=$(shell_quote "$target")
run_at=$run_at
enter=$enter
status=$(shell_quote "$status")
pid=$(shell_quote "$pid")
line_file=$(shell_quote "$line_file")
created_at=$created_at
updated_at=$updated_at
JOB
}

load_job() {
  # shellcheck disable=SC1090
  source "$1"
}

resolve_job_file() {
  local id="$1" match count=0 found=""
  ensure_dirs
  if [[ -f "$JOBS_DIR/$id.job" ]]; then
    printf '%s\n' "$JOBS_DIR/$id.job"
    return 0
  fi
  shopt -s nullglob
  for match in "$JOBS_DIR/$id"*.job; do
    found="$match"
    count=$((count + 1))
  done
  shopt -u nullglob
  if (( count == 1 )); then
    printf '%s\n' "$found"
  elif (( count == 0 )); then
    err "no job matches: $id"
    return 1
  else
    err "ambiguous job id prefix: $id"
    return 1
  fi
}

preview_line() {
  local file="$1" line count suffix=""
  line=$(head -n 1 "$file" 2>/dev/null || true)
  count=$(wc -l <"$file" 2>/dev/null || printf '0')
  if (( count > 1 )); then suffix=" (+$((count - 1)) more)"; fi
  if (( ${#line} > 72 )); then line="${line:0:69}..."; fi
  printf '%q%s' "$line" "$suffix"
}

list_jobs() {
  local all=0 arg job_file line_count due human remain
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all|-a) all=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) err "unknown list argument: $1"; return 2 ;;
    esac
  done
  ensure_dirs
  shopt -s nullglob
  local files=("$JOBS_DIR"/*.job)
  shopt -u nullglob
  if (( ${#files[@]} == 0 )); then
    echo "No tmux-send-later jobs."
    return 0
  fi
  printf '%-28s %-10s %-20s %-10s %-12s %s\n' "ID" "STATUS" "DUE" "IN" "TARGET" "LINE"
  for job_file in "${files[@]}"; do
    load_job "$job_file"
    if (( ! all )) && [[ "${status:-}" != pending ]]; then
      continue
    fi
    due=$(date -d "@${run_at}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '@%s' "$run_at")
    remain=$(( run_at - $(now_epoch) ))
    if (( remain < 0 )); then remain=0; fi
    human="${remain}s"
    printf '%-28s %-10s %-20s %-10s %-12s %s\n' "$id" "${status:-unknown}" "$due" "$human" "${target:-?}" "$(preview_line "$line_file")"
  done
}

mark_status() {
  local job_file="$1" new_status="$2" new_pid="${3:-${pid:-}}"
  load_job "$job_file"
  write_job "$job_file" "$id" "$target" "$run_at" "$enter" "$new_status" "$new_pid" "$line_file" "$created_at" "$(now_epoch)"
}

send_job_now() {
  local job_file="$1" line
  load_job "$job_file"
  if [[ -z "${target:-}" ]]; then
    err "job $id has no target pane"
    mark_status "$job_file" failed "${pid:-}"
    return 1
  fi
  if [[ ! -f "$line_file" ]]; then
    err "line file missing for job $id: $line_file"
    mark_status "$job_file" failed "${pid:-}"
    return 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -n "$line" ]]; then
      if ! tmux send-keys -t "$target" -l -- "$line"; then
        err "failed to send literal text for job $id to target $target"
        mark_status "$job_file" failed "${pid:-}"
        return 1
      fi
    fi
    if [[ "${enter:-1}" = 1 ]]; then
      if ! tmux send-keys -t "$target" Enter; then
        err "failed to send Enter for job $id to target $target"
        mark_status "$job_file" failed "${pid:-}"
        return 1
      fi
    fi
  done <"$line_file"
  mark_status "$job_file" sent ""
}

worker() {
  local job_file="$1" sleep_for
  load_job "$job_file"
  sleep_for=$(( run_at - $(now_epoch) ))
  if (( sleep_for > 0 )); then
    sleep "$sleep_for"
  fi
  [[ -f "$job_file" ]] || exit 0
  load_job "$job_file"
  [[ "${status:-}" = pending ]] || exit 0
  send_job_now "$job_file"
}

schedule() {
  local target="${TMUX_PANE:-}" when="" delay="" enter=1 text="" id run_at line_file job_file created_at pid
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --in) delay="${2:-}"; shift 2 ;;
      --in=*) delay="${1#*=}"; shift ;;
      --at|--when) when="${2:-}"; shift 2 ;;
      --at=*|--when=*) when="${1#*=}"; when="${when#*=}"; shift ;;
      -t|--target) target="${2:-}"; shift 2 ;;
      -t=*|--target=*) target="${1#*=}"; shift ;;
      --no-enter) enter=0; shift ;;
      --enter) enter=1; shift ;;
      --) shift; text="$*"; break ;;
      -h|--help) usage; return 0 ;;
      *) err "unknown schedule argument: $1"; return 2 ;;
    esac
  done

  if [[ -z "$text" ]]; then
    err "missing text. Put the line after --"
    return 2
  fi
  if [[ -n "$delay" && -n "$when" ]]; then
    err "use either --in or --at, not both"
    return 2
  fi
  if [[ -z "$delay" && -z "$when" ]]; then
    err "missing --in or --at"
    return 2
  fi
  if [[ -z "$target" ]]; then
    err "missing target and TMUX_PANE is not set; pass -t %pane"
    return 2
  fi

  if [[ -n "$delay" ]]; then
    run_at=$(parse_when "$delay")
  else
    run_at=$(parse_when "$when")
  fi

  ensure_dirs
  id=$(new_id)
  created_at=$(now_epoch)
  line_file="$JOBS_DIR/$id.lines"
  job_file="$JOBS_DIR/$id.job"
  printf '%s\n' "$text" >"$line_file"
  chmod 600 "$line_file"
  write_job "$job_file" "$id" "$target" "$run_at" "$enter" pending "" "$line_file" "$created_at" "$created_at"
  chmod 600 "$job_file"

  nohup "$0" __worker "$job_file" >"$JOBS_DIR/$id.worker.log" 2>&1 &
  pid=$!
  write_job "$job_file" "$id" "$target" "$run_at" "$enter" pending "$pid" "$line_file" "$created_at" "$(now_epoch)"

  printf 'Scheduled %s for %s to %s: %s\n' "$id" "$(date -d "@$run_at" '+%Y-%m-%d %H:%M:%S')" "$target" "$(preview_line "$line_file")"
}

cancel_one() {
  local job_file="$1"
  load_job "$job_file"
  if [[ "${status:-}" != pending ]]; then
    printf '%s is already %s\n' "$id" "${status:-unknown}"
    return 0
  fi
  if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  mark_status "$job_file" cancelled ""
  printf 'Cancelled %s\n' "$id"
}

cancel() {
  local id="${1:-}"
  if [[ -z "$id" ]]; then
    err "cancel requires an id or all"
    return 2
  fi
  ensure_dirs
  if [[ "$id" = all || "$id" = --all ]]; then
    shopt -s nullglob
    for job_file in "$JOBS_DIR"/*.job; do
      load_job "$job_file"
      [[ "${status:-}" = pending ]] && cancel_one "$job_file"
    done
    shopt -u nullglob
    return 0
  fi
  cancel_one "$(resolve_job_file "$id")"
}

run_one() {
  local job_file
  job_file=$(resolve_job_file "${1:-}")
  load_job "$job_file"
  if [[ "${status:-}" = pending && -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  send_job_now "$job_file"
  printf 'Sent %s\n' "$id"
}

cleanup() {
  local older="7d" cutoff job_file
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --older-than) older="${2:-}"; shift 2 ;;
      --older-than=*) older="${1#*=}"; shift ;;
      -h|--help) usage; return 0 ;;
      *) err "unknown cleanup argument: $1"; return 2 ;;
    esac
  done
  cutoff=$(( $(now_epoch) - $(duration_to_seconds "$older") ))
  ensure_dirs
  shopt -s nullglob
  for job_file in "$JOBS_DIR"/*.job; do
    load_job "$job_file"
    if [[ "${status:-}" != pending && "${updated_at:-0}" -lt "$cutoff" ]]; then
      rm -f "$line_file" "$job_file"
    fi
  done
  shopt -u nullglob
}

main() {
  local command="${1:-}"
  case "$command" in
    schedule) shift; schedule "$@" ;;
    list) shift; list_jobs "$@" ;;
    cancel) shift; cancel "$@" ;;
    run) shift; run_one "$@" ;;
    cleanup) shift; cleanup "$@" ;;
    __worker) shift; worker "$@" ;;
    -h|--help|help|"") usage ;;
    *) err "unknown command: $command"; usage >&2; return 2 ;;
  esac
}

main "$@"
