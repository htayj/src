#!/usr/bin/env python3
"""Monitor ffmpeg signalstats output for the EasyCAP/VCR blue screen."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import signal
import sys
import time
from typing import TextIO


STAT_PREFIX = "lavfi.signalstats."


def is_vcr_blue(frame: dict[str, float]) -> bool:
    """Match the uniform blue generated by this VCR through the MS210x."""
    required = ("YAVG", "UAVG", "VAVG", "YLOW", "YHIGH", "ULOW", "UHIGH", "VLOW", "VHIGH")
    if any(key not in frame for key in required):
        return False

    return (
        34.0 <= frame["YAVG"] <= 48.0
        and 185.0 <= frame["UAVG"] <= 205.0
        and 105.0 <= frame["VAVG"] <= 121.0
        and frame["YHIGH"] - frame["YLOW"] <= 5.0
        and frame["UHIGH"] - frame["ULOW"] <= 5.0
        and frame["VHIGH"] - frame["VLOW"] <= 5.0
    )


class Detector:
    def __init__(self, *, blue_seconds: int, arm_seconds: int) -> None:
        self.blue_seconds = blue_seconds
        self.arm_seconds = arm_seconds
        self.non_blue_run = 0
        self.blue_run = 0
        self.armed = False
        self.detected_at: float | None = None

    def add(self, frame: dict[str, float]) -> bool:
        blue = is_vcr_blue(frame)
        if not self.armed:
            self.non_blue_run = 0 if blue else self.non_blue_run + 1
            if self.non_blue_run >= self.arm_seconds:
                self.armed = True
            return False

        self.blue_run = self.blue_run + 1 if blue else 0
        if self.blue_run >= self.blue_seconds:
            self.detected_at = frame.get("pts_time")
            return True
        return False


def frames_from_lines(lines: list[str], *, include_last: bool) -> list[dict[str, float]]:
    frames: list[dict[str, float]] = []
    current: dict[str, float] = {}

    for raw_line in lines:
        line = raw_line.strip()
        if line.startswith("frame:"):
            if current:
                frames.append(current)
            current = {}
            for field in line.split():
                if field.startswith("pts_time:"):
                    try:
                        current["pts_time"] = float(field.split(":", 1)[1])
                    except ValueError:
                        pass
        elif line.startswith(STAT_PREFIX) and "=" in line:
            key, value = line.split("=", 1)
            try:
                current[key.removeprefix(STAT_PREFIX)] = float(value)
            except ValueError:
                pass

    if include_last and current:
        frames.append(current)
    return frames


def write_status(path: Path, detected_at: float | None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    timestamp = "unknown" if detected_at is None else f"{detected_at:.3f}"
    temporary.write_text(f"reason=auto_blue_screen\npts_time={timestamp}\n", encoding="utf-8")
    temporary.replace(path)


def process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def analyze(path: Path, detector: Detector, output: TextIO) -> int:
    frames = frames_from_lines(path.read_text(encoding="utf-8").splitlines(), include_last=True)
    for frame in frames:
        if detector.add(frame):
            timestamp = "unknown" if detector.detected_at is None else f"{detector.detected_at:.3f}"
            print(f"blue_screen_detected=yes pts_time={timestamp}", file=output)
            return 0
    print(
        f"blue_screen_detected=no armed={'yes' if detector.armed else 'no'} "
        f"longest_current_blue_run={detector.blue_run}",
        file=output,
    )
    return 1


def follow(path: Path, detector: Detector, *, pid: int, status_path: Path, poll: float) -> int:
    offset = 0
    pending = ""
    current: dict[str, float] = {}

    while process_alive(pid):
        try:
            with path.open("r", encoding="utf-8") as stream:
                stream.seek(offset)
                chunk = stream.read()
                offset = stream.tell()
        except FileNotFoundError:
            time.sleep(poll)
            continue

        if not chunk:
            time.sleep(poll)
            continue

        pending += chunk
        complete_lines = pending.split("\n")
        pending = complete_lines.pop()

        for raw_line in complete_lines:
            line = raw_line.strip()
            if line.startswith("frame:"):
                if current and detector.add(current):
                    write_status(status_path, detector.detected_at)
                    try:
                        os.kill(pid, signal.SIGINT)
                    except ProcessLookupError:
                        pass
                    return 0
                current = {}
                for field in line.split():
                    if field.startswith("pts_time:"):
                        try:
                            current["pts_time"] = float(field.split(":", 1)[1])
                        except ValueError:
                            pass
            elif line.startswith(STAT_PREFIX) and "=" in line:
                key, value = line.split("=", 1)
                try:
                    current[key.removeprefix(STAT_PREFIX)] = float(value)
                except ValueError:
                    pass

    return 0


def positive_integer(value: str) -> int:
    parsed = int(value)
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return parsed


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--stats", required=True, type=Path, help="ffmpeg metadata=print output")
    parser.add_argument("--blue-seconds", type=positive_integer, default=8)
    parser.add_argument("--arm-seconds", type=positive_integer, default=10)
    parser.add_argument("--analyze", action="store_true", help="analyze a completed stats file")
    parser.add_argument("--pid", type=positive_integer, help="ffmpeg PID to interrupt")
    parser.add_argument("--status", type=Path, help="status file to write on detection")
    parser.add_argument("--poll", type=float, default=0.25)
    args = parser.parse_args()

    if not args.analyze and (args.pid is None or args.status is None):
        parser.error("live monitoring requires --pid and --status")
    if args.poll <= 0:
        parser.error("--poll must be positive")
    return args


def main() -> int:
    args = parse_args()
    detector = Detector(blue_seconds=args.blue_seconds, arm_seconds=args.arm_seconds)
    if args.analyze:
        return analyze(args.stats, detector, sys.stdout)
    return follow(args.stats, detector, pid=args.pid, status_path=args.status, poll=args.poll)


if __name__ == "__main__":
    raise SystemExit(main())
