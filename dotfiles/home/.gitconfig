[user]
	name = htayj
	email = htayj@users.noreply.github.com
	signingkey = 6A27F433DC22B4DFA278E8F32F12E6A35F417606 # gitleaks:allow (public agent PGP fingerprint)

[gpg]
	format = openpgp
	program = /home/tay/.local/bin/gpg-agent-signing
[commit]
	gpgsign = true
[tag]
	gpgsign = true

[alias]
	human-commit = !/home/tay/.local/bin/git-human-commit
	human-tag = !/home/tay/.local/bin/git-human-tag

[maintenance]
	repo = /home/tay/.emacs.d

[spice "forge.gitlab"]
	url = https://git.codemettle.com
