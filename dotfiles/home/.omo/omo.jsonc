{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k3",
      "reasoning": "max"
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "xhigh"
    },
    "librarian": {
      "model": "openai/gpt-5.6-luna-fast",
      "reasoning": "low"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna-fast",
      "reasoning": "low"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "low"
    },
    "prometheus": {
      "model": "anthropic/claude-fable-5",
      "reasoning": "xhigh"
    },
    "metis": {
      "model": "kimi-for-coding/k3",
      "reasoning": "high"
    },
    "momus": {
      "model": "openai/gpt-5.6-terra",
      "reasoning": "high"
    },
    "atlas": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "kimi-for-coding/k3",
      "reasoning": "max"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "artistry": {
      "model": "anthropic/claude-fable-5",
      "reasoning": "xhigh"
    },
    "quick": {
      "model": "kimi-for-coding/kimi-for-coding-highspeed"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.6-terra",
      "reasoning": "high"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.6-terra",
      "reasoning": "high"
    },
    "writing": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "low"
    }
  },
  "[opencode]": {
    "telemetry": false,
    "disabled_hooks": [
      "auto-update-checker",
      "startup-toast"
    ],
    "agents": {
      "sisyphus": {
        "fallback_models": [
          "openai/gpt-5.6-sol:medium",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "hephaestus": {
        "fallback_models": [
          "openai/gpt-5.6-terra:high",
          "openai/gpt-5.5:high"
        ]
      },
      "oracle": {
        "fallback_models": [
          "kimi-for-coding/k3:max",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "librarian": {
        "fallback_models": [
          "xai/grok-4.20-0309-non-reasoning",
          "zai-coding-plan/glm-5.2-highspeed",
          "kimi-for-coding/kimi-for-coding-highspeed"
        ]
      },
      "explore": {
        "fallback_models": [
          "xai/grok-4.20-0309-non-reasoning",
          "zai-coding-plan/glm-5.2-highspeed",
          "kimi-for-coding/kimi-for-coding-highspeed"
        ]
      },
      "multimodal-looker": {
        "fallback_models": [
          "xai/grok-4.5",
          "kimi-for-coding/k3"
        ]
      },
      "prometheus": {
        "fallback_models": [
          "kimi-for-coding/k3:max",
          "openai/gpt-5.6-sol:xhigh",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "metis": {
        "fallback_models": [
          "openai/gpt-5.6-sol:high",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "momus": {
        "fallback_models": [
          "openai/gpt-5.6-sol:xhigh",
          "kimi-for-coding/k3:max",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "atlas": {
        "fallback_models": [
          "kimi-for-coding/k3:max",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "sisyphus-junior": {
        "fallback_models": [
          "kimi-for-coding/k3:max",
          "zai-coding-plan/glm-5.2"
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "fallback_models": [
          "zai-coding-plan/glm-5.2",
          "openai/gpt-5.6-sol:medium"
        ]
      },
      "ultrabrain": {
        "fallback_models": [
          "kimi-for-coding/k3:max",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "deep": {
        "fallback_models": [
          "xai/grok-4.20-0309-reasoning",
          "kimi-for-coding/k3:max",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "artistry": {
        "fallback_models": [
          "kimi-for-coding/k3:max",
          "xai/grok-4.5",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "quick": {
        "fallback_models": [
          "zai-coding-plan/glm-5.2-highspeed",
          "xai/grok-4.20-0309-non-reasoning",
          "openai/gpt-5.6-luna-fast:low"
        ]
      },
      "unspecified-low": {
        "fallback_models": [
          "kimi-for-coding/kimi-for-coding-highspeed",
          "xai/grok-4.20-0309-non-reasoning",
          "zai-coding-plan/glm-5.2-highspeed"
        ]
      },
      "unspecified-high": {
        "fallback_models": [
          "kimi-for-coding/k3:max",
          "zai-coding-plan/glm-5.2"
        ]
      },
      "writing": {
        "fallback_models": [
          "anthropic/claude-fable-5:xhigh",
          "xai/grok-4.5"
        ]
      }
    },
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        400,
        401,
        402,
        403,
        404,
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}
