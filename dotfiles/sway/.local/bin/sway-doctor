#!/usr/bin/env bash
# Diagnose a running Sway session. Run this INSIDE sway when something is wrong.
#
# Exists because the first failed attempt was hard to debug: sway's stderr went
# to ~/.local/share/sddm/wayland-session.log, which the next login overwrote.
set -u

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

echo "== session =="
[ -n "${WAYLAND_DISPLAY:-}" ] && ok "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" || bad "WAYLAND_DISPLAY unset — not in a Wayland session"
[ "${XDG_CURRENT_DESKTOP:-}" = sway ] && ok "XDG_CURRENT_DESKTOP=sway" || warn "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset} (expected sway)"
if [ -n "${SWAY_UNSUPPORTED_GPU:-}" ]; then
    ok "SWAY_UNSUPPORTED_GPU set — no NVIDIA banner"
else
    bad "SWAY_UNSUPPORTED_GPU unset — you will get the NVIDIA banner."
    echo "      This means sway was NOT launched via ~/.local/bin/sway-session."
    echo "      Pick the 'Sway (tay)' session at SDDM, not the plain 'Sway' one."
fi

echo "== systemd/dbus environment (empty tray + dead portals live here) =="
env_ok=1
for v in WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK; do
    systemctl --user show-environment 2>/dev/null | grep -q "^$v=" \
        && ok "$v exported to systemd --user" || { bad "$v NOT in systemd --user env"; env_ok=0; }
done
[ $env_ok -eq 0 ] && echo "      Check that your config still has: include /etc/sway/config.d/*"

echo "== keyboard: the important one =="
if ! command -v swaymsg >/dev/null; then bad "swaymsg missing"; exit 1; fi
layouts=$(swaymsg -t get_inputs 2>/dev/null \
    | jq -r '.[] | select(.type=="keyboard") | "\(.identifier)|\(.xkb_active_layout_name)"')
if [ -z "$layouts" ]; then
    bad "no keyboards reported by sway"
else
    while IFS='|' read -r id lay; do
        case "$lay" in
            *"Space Cadet"*) ok "$id -> $lay" ;;
            *) bad "$id -> $lay   (expected 'Space Cadet')"
               echo "      Mod4 is NOT RALT right now, so \$mod bindings will not fire."
               echo "      Check: xkb_file in ~/.config/sway/config.d/10-input.conf" ;;
        esac
    done <<< "$layouts"
fi

echo "== kanata =="
for u in kanata@advantage360 kanata@footswitches; do
    s=$(systemctl --user is-active "$u" 2>/dev/null)
    [ "$s" = active ] && ok "$u active" || bad "$u $s"
done
if journalctl --user -u kanata@advantage360 -n 50 --no-pager 2>/dev/null | grep -q 'registering'; then
    ok "kanata grabbed a physical keyboard: $(journalctl --user -u kanata@advantage360 -n 50 --no-pager 2>/dev/null | grep -o 'registering [^:]*' | tail -1)"
else
    warn "no 'registering' line in kanata's recent log — is the Adv360 plugged in?"
fi

echo "== outputs =="
swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | "  \(.name) \(.current_mode.width)x\(.current_mode.height)@\(.current_mode.refresh/1000|floor)Hz active=\(.active)"'

echo "== bar =="
swaymsg -t get_bar_config 2>/dev/null | jq -r '.[]' | while read -r b; do
    swaymsg -t get_bar_config "$b" 2>/dev/null | jq -r '"  \(.id): mode=\(.mode) status=\(.status_command // "none")"'
done

echo "== portals =="
systemctl --user is-active xdg-desktop-portal >/dev/null 2>&1 \
    && ok "xdg-desktop-portal running" || warn "xdg-desktop-portal not running"
[ -r /usr/share/xdg-desktop-portal/sway-portals.conf ] \
    && ok "sway-portals.conf present" || warn "sway-portals.conf missing"

echo
echo "Full sway log (only if launched via sway-session):  journalctl --user -t sway -b"
