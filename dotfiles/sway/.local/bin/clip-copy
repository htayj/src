#!/usr/bin/env bash
# Session-agnostic clipboard copy: reads stdin, writes to whichever clipboard
# this session actually has.
#
# Exists so shared configs (notably ~/.config/zellij/config.kdl, which hardcoded
# `xclip -selection clipboard') work under both the Sway and StumpWM sessions.
set -eu
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
    exec xsel --clipboard --input
else
    echo "clip-copy: no clipboard tool found" >&2
    exit 127
fi
