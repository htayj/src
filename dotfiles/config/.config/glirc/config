-- vim: filetype=config-value
-- All connections attach to already-configured ZNC networks. ZNC owns the
-- channel list; do not add connect-cmds or automatic channel joins here.
-- Launch with `glirc` (not with a manually supplied network).
-- The shared certificate is public; no secret or private key is stored here.
defaults:
  hostname: "192.168.1.242"
  port: 8887
  tls: yes
  tls-verify: yes
  tls-server-cert: "~/.config/halloy/znc-truenas.pem"
  password:
    command: ["rbw", "get", "970a7b5a-5c23-4dc1-ad9a-ae92e92b9229"]
  autoconnect: yes

