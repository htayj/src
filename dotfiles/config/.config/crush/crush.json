{
  "$schema": "https://charm.land/crush.json",
  "models": {
    "large": {
      "provider": "openai-codex",
      "model": "gpt-5.5",
      "reasoning_effort": "medium"
    },
    "small": {
      "provider": "openai-codex",
      "model": "gpt-5.4-mini",
      "reasoning_effort": "medium"
    }
  },
  "providers": {
    "openai-codex": {
      "id": "openai-codex",
      "name": "OpenAI Codex (ChatGPT OAuth)",
      "type": "openai",
      "base_url": "https://chatgpt.com/backend-api/codex",
      "api_key": "$(/home/tay/.local/bin/crush-openai-codex-auth access-token)",
      "flat_rate": true,
      "extra_headers": {
        "chatgpt-account-id": "$(/home/tay/.local/bin/crush-openai-codex-auth account-id)",
        "originator": "codex_cli_rs",
        "OpenAI-Beta": "responses=experimental",
        "User-Agent": "crush-openai-codex"
      },
      "provider_options": {
        "store": false,
        "parallel_tool_calls": true,
        "reasoning_summary": "auto",
        "include": [
          "reasoning.encrypted_content"
        ],
        "instructions": "Follow the provided system and developer instructions. You are a helpful coding assistant."
      },
      "models": [
