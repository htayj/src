[Unit]
Description=kanata keyboard remapper (%I)
Documentation=https://github.com/jtroo/kanata
# No graphical ordering: kanata talks to /dev/uinput and needs no display
# server. Starting it independently of the session means the remapped keyboard
# is already live at the display-manager password prompt.

[Service]
Type=simple
ExecStart=%h/kanata-launch.sh %i
# When the target keyboard isn't plugged in, kanata exits immediately;
# keep retrying on a slow cadence rather than burning a hot loop.
Restart=on-failure
RestartSec=60s
# Disable the default 5-failures-in-10s burst limit so the retry loop
# survives an indefinitely-unplugged keyboard.
StartLimitBurst=0
# Re-apply the user XKB keymap after kanata's uinput device appears.
#
# X11 ONLY. X auto-applies the default us layout to any newly-attached keyboard
# device, clobbering the spacecadet map on kanata's virtual keyboard. Sway needs
# none of this: it applies `input' config to devices as they appear, including
# recreated ones, so the guard below skips the helper under Wayland instead of
# leaving it to fail noisily. The leading '-' keeps it non-fatal regardless.
ExecStartPost=-/bin/bash -c '[ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && sleep 2 && %h/reload-spacecadet-xkb.sh'

[Install]
WantedBy=default.target
