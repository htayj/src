{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "okf-network": {
      "path": "~/okf/network",
      "description": "Source of truth for the home network: hosts, Tailscale topology, domains, services, storage, runbooks. Start with index.md."
    },
    "okf-models": {
      "path": "~/okf/models",
      "description": "Catalog of AI models accessible via OpenCode: providers, lineages, benchmark limitations, independent reputation, routing guidance, and capability gaps. Start with index.md."
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://192.168.1.189:1234/v1"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "qwen/qwen3.5-9b"
        },
        "qwen3-coder-next": {
          "name": "qwen3-coder-next"
        },
        "openai/gpt-oss-20b": {
          "name": "openai/gpt-oss-20b"
        },
        "google/gemma-3-12b": {
          "name": "google/gemma-3-12b"
        },
        "qwen/qwen3-vl-8b": {
          "name": "qwen/qwen3-vl-8b"
        },
        "deepseek/deepseek-r1-0528-qwen3-8b": {
          "name": "deepseek/deepseek-r1-0528-qwen3-8b"
        },
        "zai-org/glm-4.6v-flash": {
          "name": "zai-org/glm-4.6v-flash"
        },
        "mistralai/ministral-3-14b-reasoning": {
          "name": "mistralai/ministral-3-14b-reasoning"
        },
        "zai-org/glm-4.7-flash": {
          "name": "zai-org/glm-4.7-flash"
        },
        "google/gemma-3-4b": {
          "name": "google/gemma-3-4b"
        },
        "text-embedding-nomic-embed-text-v1.5": {
          "name": "text-embedding-nomic-embed-text-v1.5"
        }
      }
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--open-web-dashboard",
        "False",
        "--project-from-cwd"
      ]
    },
    "supermodel": {
      "type": "local",
      "enabled": false,
      "timeout": 120000,
      "command": [
        "npx",
        "-y",
        "@supermodeltools/mcp-server"
      ],
      "environment": {
        "SUPERMODEL_API_KEY": "{env:SUPERMODEL_API_KEY}",
        "SUPERMODEL_TIMEOUT_MS": "900000"
      }
    },
    "supermodel_graphrag": {
      "type": "local",
      "enabled": false,
      "timeout": 120000,
      "command": [
        "npx",
        "-y",
        "@supermodeltools/mcp-server"
      ],
      "environment": {
        "SUPERMODEL_API_KEY": "{env:SUPERMODEL_API_KEY}",
        "SUPERMODEL_EXPERIMENT": "graphrag",
        "SUPERMODEL_TIMEOUT_MS": "900000"
      }
    }
  },
  "plugin": [
    "/home/tay/.config/opencode/plugins/tmux-session-restore.js",
    "@ex-machina/opencode-anthropic-auth@1.8.1"
  ]
}
