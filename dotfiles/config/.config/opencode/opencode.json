  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--open-web-dashboard",
        "False",
        "--project-from-cwd"
      ]
    },
    "supermodel": {
      "type": "local",
      "enabled": false,
      "timeout": 120000,
      "command": [
        "npx",
        "-y",
        "@supermodeltools/mcp-server"
      ],
      "environment": {
        "SUPERMODEL_API_KEY": "{env:SUPERMODEL_API_KEY}",
        "SUPERMODEL_TIMEOUT_MS": "900000"
      }
    },
    "supermodel_graphrag": {
      "type": "local",
      "enabled": false,
      "timeout": 120000,
      "command": [
        "npx",
        "-y",
        "@supermodeltools/mcp-server"
      ],
      "environment": {
        "SUPERMODEL_API_KEY": "{env:SUPERMODEL_API_KEY}",
        "SUPERMODEL_EXPERIMENT": "graphrag",
        "SUPERMODEL_TIMEOUT_MS": "900000"
      }
    },
    "omniroute": {
      "type": "remote",
      "enabled": true,
      "timeout": 120000,
      "url": "http://192.168.7.116/api/mcp/stream",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:OMNIROUTE_API_KEY}"
      }
    },
    "benchmarks": {
      "type": "local",
      "enabled": true,
      "command": ["node", "/home/tay/projects/benchmarks-mcp/dist/mcp/index.js"],
      "environment": {
        "BENCHMARKS_DB": "/home/tay/projects/benchmarks-mcp/data/benchmarks.db"
      }
    },
    "gramps": {
      "type": "local",
      "enabled": true,
      "command": [
        "dotnet",
        "run",
        "--project",
        "/home/tay/.local/share/mcp-servers/gramps-web-mcp/GrampsWeb.Mcp/GrampsWeb.Mcp.csproj",
        "--no-launch-profile"
      ],
      "environment": {
        "MCP_TRANSPORT": "stdio",
        "GRAMPS_API_URL": "http://192.168.7.118",
        "GRAMPS_USERNAME": "{env:GRAMPS_USERNAME}",
        "GRAMPS_PASSWORD": "{env:GRAMPS_PASSWORD}",
        "GRAMPS_TREE_ID": "{env:GRAMPS_TREE_ID}",
        "GRAMPS_READ_ONLY": "false"
      }
    }
  },
  "plugin": [
    "/home/tay/.config/opencode/plugins/tmux-session-restore.js",
    "@ex-machina/opencode-anthropic-auth@1.8.1"
  ]
}
