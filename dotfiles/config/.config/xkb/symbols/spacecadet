// User-level Space Cadet XKB layout translated from ~/.Xmodmap.
//
// Layers match the old xmodmap ordering:
//   level 1/2: normal/Shift
//   level 3/4: Greek/APL via the old Mode_switch key (<ZEHA>, xmodmap keycode 93)
//   level 5/6: Top/math via the old ISO_Level3_Shift key (<LVL3>, xmodmap keycode 92)
//   level 7/8: reserved, accessed via <CAPS> as LevelSeven (held; Lock bit
//              repurposed as a hold modifier -- see virtual_modifiers below)

partial alphanumeric_keys modifier_keys
xkb_symbols "base" {
    include "us(basic)"

    name[Group1] = "Space Cadet";

    // LevelSeven realized on the Lock real-modifier. The Caps key below emits
    // VoidSymbol (not Caps_Lock), so the compat catchall does SetMods (hold)
    // instead of the Caps_Lock-specific LockMods (latch). Result: <CAPS> acts
    // as a normal held modifier on the Lock bit.
    virtual_modifiers LevelSeven=Lock;

    key <ESC>  { type="ONE_LEVEL", [ Escape ] };
    key <LFSH> { type="ONE_LEVEL", [ Shift_L ] };
    key <RTSH> { type="ONE_LEVEL", [ Shift_R ] };
    key <MENU> { type="ONE_LEVEL", [ Menu ] };
    key <PRSC> { type="PC_ALT_LEVEL2", [ Print, Sys_Req ] };
    key <SCLK> { type="ONE_LEVEL", [ Scroll_Lock ] };
    key <PAUS> { type="PC_CONTROL_LEVEL2", [ Pause, Break ] };
    key <INS>  { type="ONE_LEVEL", [ Insert ] };
    key <DELE> { type="ONE_LEVEL", [ Delete ] };
    key <HOME> { type="ONE_LEVEL", [ Home ] };
    key <END>  { type="ONE_LEVEL", [ End ] };
    key <PGUP> { type="ONE_LEVEL", [ Prior ] };
    key <PGDN> { type="ONE_LEVEL", [ Next ] };
    key <UP>   { type="ONE_LEVEL", [ Up ] };
    key <DOWN> { type="ONE_LEVEL", [ Down ] };
    key <LEFT> { type="ONE_LEVEL", [ Left ] };
    key <RGHT> { type="ONE_LEVEL", [ Right ] };
    key <NMLK> { type="ONE_LEVEL", [ Num_Lock ] };
    key <MUHE> { type="ONE_LEVEL", [ Muhenkan ] };
    key <HENK> { type="ONE_LEVEL", [ Henkan ] };
    key <HKTG> { type="ONE_LEVEL", [ Hiragana_Katakana ] };
    key <HIRA> { type="ONE_LEVEL", [ Hiragana ] };
    key <KATA> { type="ONE_LEVEL", [ Katakana ] };
    key <HNGL> { type="ONE_LEVEL", [ Hangul ] };
    key <HJCV> { type="ONE_LEVEL", [ Hangul_Hanja ] };

    key <AE01> { type="EIGHT_LEVEL", [ 1, exclam, dagger, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE02> { type="EIGHT_LEVEL", [ 2, at, doubledagger, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE03> { type="EIGHT_LEVEL", [ 3, numbersign, opentribulletdown, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE04> { type="EIGHT_LEVEL", [ 4, dollar, cent, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE05> { type="EIGHT_LEVEL", [ 5, percent, circle, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE06> { type="EIGHT_LEVEL", [ 6, asciicircum, U25AF, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE07> { type="EIGHT_LEVEL", [ 7, ampersand, division, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE08> { type="EIGHT_LEVEL", [ 8, asterisk, multiply, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE09> { type="EIGHT_LEVEL", [ 9, parenleft, paragraph, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE10> { type="EIGHT_LEVEL", [ 0, parenright, emopencircle, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE11> { type="EIGHT_LEVEL", [ minus, underscore, U2248, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AE12> { type="EIGHT_LEVEL", [ equal, plus, U2205, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <BKSP> { type="EIGHT_LEVEL", [ BackSpace, BackSpace, BackSpace, BackSpace, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <TAB>  { type="EIGHT_LEVEL", [ Tab, ISO_Left_Tab, Tab, ISO_Left_Tab, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };

    key <AD01> { type="EIGHT_LEVEL_ALPHABETIC", [ q, Q, Greek_theta, Greek_THETA, upcaret, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD02> { type="EIGHT_LEVEL_ALPHABETIC", [ w, W, Greek_omega, Greek_OMEGA, downcaret, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD03> { type="EIGHT_LEVEL_ALPHABETIC", [ e, E, Greek_epsilon, Greek_EPSILON, downshoe, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD04> { type="EIGHT_LEVEL_ALPHABETIC", [ r, R, Greek_rho, Greek_RHO, upshoe, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD05> { type="EIGHT_LEVEL_ALPHABETIC", [ t, T, Greek_tau, Greek_TAU, leftshoe, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD06> { type="EIGHT_LEVEL_ALPHABETIC", [ y, Y, Greek_psi, Greek_PSI, rightshoe, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD07> { type="EIGHT_LEVEL_ALPHABETIC", [ u, U, Greek_upsilon, Greek_UPSILON, U2200, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD08> { type="EIGHT_LEVEL_ALPHABETIC", [ i, I, Greek_iota, Greek_IOTA, infinity, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD09> { type="EIGHT_LEVEL_ALPHABETIC", [ o, O, Greek_omicron, Greek_OMICRON, U2203, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD10> { type="EIGHT_LEVEL_ALPHABETIC", [ p, P, Greek_pi, Greek_PI, partialderivative, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD11> { type="EIGHT_LEVEL", [ bracketleft, braceleft, U27E6, U2983, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AD12> { type="EIGHT_LEVEL", [ bracketright, braceright, U27E7, U2984, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <RTRN> { type="EIGHT_LEVEL", [ Return, NoSymbol, Linefeed, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };

    key <AC01> { type="EIGHT_LEVEL_ALPHABETIC", [ a, A, Greek_alpha, Greek_ALPHA, uptack, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC02> { type="EIGHT_LEVEL_ALPHABETIC", [ s, S, Greek_sigma, Greek_SIGMA, downtack, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC03> { type="EIGHT_LEVEL_ALPHABETIC", [ d, D, Greek_delta, Greek_DELTA, righttack, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC04> { type="EIGHT_LEVEL_ALPHABETIC", [ f, F, Greek_phi, Greek_PHI, lefttack, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC05> { type="EIGHT_LEVEL_ALPHABETIC", [ g, G, Greek_gamma, Greek_GAMMA, uparrow, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC06> { type="EIGHT_LEVEL_ALPHABETIC", [ h, H, Greek_eta, Greek_ETA, downarrow, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC07> { type="EIGHT_LEVEL_ALPHABETIC", [ j, J, U03D1, U03F4, leftarrow, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC08> { type="EIGHT_LEVEL_ALPHABETIC", [ k, K, Greek_kappa, Greek_KAPPA, rightarrow, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC09> { type="EIGHT_LEVEL_ALPHABETIC", [ l, L, Greek_lambda, Greek_LAMBDA, U2194, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC10> { type="EIGHT_LEVEL", [ semicolon, colon, diaeresis, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AC11> { type="EIGHT_LEVEL", [ apostrophe, quotedbl, periodcentered, U0387, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };

    key <TLDE> { type="EIGHT_LEVEL", [ grave, asciitilde, grave, asciitilde, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <BKSL> { type="EIGHT_LEVEL", [ backslash, bar, U2016, brokenbar, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB01> { type="EIGHT_LEVEL_ALPHABETIC", [ z, Z, Greek_zeta, Greek_ZETA, downcaret, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB02> { type="EIGHT_LEVEL_ALPHABETIC", [ x, X, Greek_xi, Greek_XI, downstile, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB03> { type="EIGHT_LEVEL_ALPHABETIC", [ c, C, Greek_chi, Greek_CHI, upstile, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB04> { type="EIGHT_LEVEL_ALPHABETIC", [ v, V, Greek_finalsmallsigma, Greek_SIGMA, similarequal, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB05> { type="EIGHT_LEVEL_ALPHABETIC", [ b, B, Greek_beta, Greek_BETA, identical, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB06> { type="EIGHT_LEVEL_ALPHABETIC", [ n, N, Greek_nu, Greek_NU, lessthanequal, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB07> { type="EIGHT_LEVEL_ALPHABETIC", [ m, M, Greek_mu, Greek_MU, greaterthanequal, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB08> { type="EIGHT_LEVEL", [ comma, less, guillemetleft, U300A, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB09> { type="EIGHT_LEVEL", [ period, greater, guillemetright, U300B, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <AB10> { type="EIGHT_LEVEL", [ slash, question, integral, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <SPCE> { type="EIGHT_LEVEL", [ space, NoSymbol, space, NoSymbol, NoSymbol, NoSymbol, NoSymbol, NoSymbol ] };
    key <LSGT> { type="EIGHT_LEVEL", [ less, greater, less, greater, bar, brokenbar, bar, NoSymbol ] };

    replace key <CAPS> { type="ONE_LEVEL", [ VoidSymbol ] };
    replace key <LCTL> { type="ONE_LEVEL", [ Control_L ] };
    replace key <RCTL> { type="ONE_LEVEL", [ Control_R ] };
    replace key <RALT> { type="ONE_LEVEL", [ Alt_L ] };
    replace key <LALT> { type="ONE_LEVEL", [ Meta_L ] };
    replace key <LWIN> { type="ONE_LEVEL", [ Super_L ] };
    replace key <RWIN> { type="ONE_LEVEL", [ Hyper_L ] };
    replace key <LVL3> { type="ONE_LEVEL", [ ISO_Level5_Shift ] };
    replace key <LVL5> { type="ONE_LEVEL", [ ISO_Level5_Shift ] };
    override key <ZEHA> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ ISO_Level3_Shift ] };

    // Modifier slot layout (final, after resolving inherited bindings):
    //   Lock: <CAPS> (VoidSymbol) -- realized virtual mod "LevelSeven"
    //   Mod1: Alt_L (LALT) + Alt_L (RALT) -- thumb Alts; apps see "Alt", Emacs uses as Meta
    //   Mod2: Hyper_L (RWIN)
    //   Mod3: ISO_Level5_Shift (LVL3, LVL5) -- "Top" / math+APL layer
    //   Mod4: Super_L (LWIN)
    //   Mod5: ISO_Level3_Shift (ZEHA) -- "Greek" layer
    //
    // Expected xkbcomp warning when this file loads:
    //   "Key <LVL3> added to map for multiple modifiers, Using Mod3, ignoring Mod5"
    // Why: /usr/share/X11/xkb/symbols/pc unconditionally does
    //   modifier_map Mod5 { <LVL3> };
    // and our keymap includes "pc+...+spacecadet(base)". xkb's modifier_map
    // statements accumulate across included files; there is no portable
    // "remove from modifier_map" syntax, and an explicit Mod-slot beats both
    // None and any other Mod-slot. xkbcomp resolves the conflict in favour
    // of our Mod3 binding (verified via xmodmap: LVL3 ends up on Mod3 only,
    // Mod5 contains only ZEHA), so the warning is informational and the
    // final state is correct.
    modifier_map None    { <RCTL>, <NMLK> };
    modifier_map Control { <LCTL> };
    modifier_map Lock    { <CAPS> };
    modifier_map Mod1    { <LALT>, <RALT> };
    modifier_map Mod2    { <RWIN> };
    modifier_map Mod3    { <LVL3>, <LVL5> };
    modifier_map Mod4    { <LWIN> };
    modifier_map Mod5    { <ZEHA> };
};

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
    include "spacecadet(base)"
};
