   "sh -lc 'dir=$HOME/Pictures/Screenshots; mkdir -p \"$dir\"; file=$dir/screenshot-$(date +%Y%m%d-%H%M%S).png; scrot -s \"$file\" && printf %s \"$file\" | xclip -selection clipboard'"))

