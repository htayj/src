;; Lock screen
(define-key *root-map* (kbd "s-l") "exec slock")
(define-key *root-map* (kbd "s-l") "exec slock")
(define-key *root-map* (kbd "c") "exec ghostty")
(define-key *root-map* (kbd "s-o") "exec scrot -s")

;;; marking windows with ;
(define-key *top-map* (kbd "s-;") "mark")
;;; i3 type bindings
;;; focus frames using vim binds
(define-key *top-map* (kbd "s-l") "move-focus right")
(define-key *top-map* (kbd "s-h") "move-focus left")
(define-key *top-map* (kbd "s-j") "move-focus down")
(define-key *top-map* (kbd "s-k") "move-focus up")

;;; move windows between frames using s-S-[vim movement] 
(define-key *top-map* (kbd "s-L") "move-window right")
(define-key *top-map* (kbd "s-H") "move-window left")
(define-key *top-map* (kbd "s-J") "move-window down")
(define-key *top-map* (kbd "s-K") "move-window up")

;;; next and prev window
(define-key *top-map* (kbd "s-n") "pull-hidden-next")
(define-key *top-map* (kbd "s-p") "pull-hidden-previous")

;;; float control
(define-key *top-map* (kbd "s-f") "my-toggle-float")

;;; focus a group using s-[number]
(define-key *top-map* (kbd "s-1") "gnew one")
(define-key *top-map* (kbd "s-2") "gnew two")
(define-key *top-map* (kbd "s-3") "gnew three")
(define-key *top-map* (kbd "s-4") "gnew four")
(define-key *top-map* (kbd "s-5") "gnew five")
(define-key *top-map* (kbd "s-6") "gnew six")
(define-key *top-map* (kbd "s-7") "gnew seven")
(define-key *top-map* (kbd "s-8") "gnew eight")
(define-key *top-map* (kbd "s-9") "gnew nine")
(define-key *top-map* (kbd "s-0") "gnew Default")

;;; move window to a group using s-S-[number]
(define-key *top-map* (kbd "s-!") "gmove one")
(define-key *top-map* (kbd "s-@") "gmove two")
(define-key *top-map* (kbd "s-#") "gmove three")
(define-key *top-map* (kbd "s-$") "gmove four")
(define-key *top-map* (kbd "s-%") "gmove five")
(define-key *top-map* (kbd "s-^") "gmove six")
(define-key *top-map* (kbd "s-&") "gmove seven")
(define-key *top-map* (kbd "s-*") "gmove eight")
(define-key *top-map* (kbd "s-(") "gmove nine")
(define-key *top-map* (kbd "s-)") "gmove Default")

;;; application launcher
(define-key *top-map* (kbd "s-SPC") "exec rofi -config ~/.config/rofi/NsCDE.rasi -show drun")

(define-key *top-map* (kbd "s-SunProps") "show-window-properties")
;;; mouseover focus
(setf *mouse-focus-policy* :click)

