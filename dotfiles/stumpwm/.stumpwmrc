;;; Alt+Button3 drag → resize current frame (frame split, not window).
;;; The kbd parser doesn't accept "ButtonN", so dispatch via an :around
;;; method on group-button-press for tile-group.  We intercept before the
;;; default click-to-focus handler so the press doesn't double-act.
(defmethod group-button-press :around
    ((group tile-group) button x y where)
  (declare (ignore x y where))
  (if (and (eq button :right-button)
           (member :shift *button-state*)
           (intersection (modifiers-alt *modifiers*) *button-state*))
      (mouse-resize-frame)
      (call-next-method)))

