(setf *mode-line-background-color* "#000"
      *mode-line-foreground-color* "#aaa"
      *mode-line-border-color* "#aa5500"
      *mode-line-timeout* 5
      *mode-line-border-width* 1
      *mode-line-pad-x* 1
      *mode-line-pad-y* 1)
(setf *screen-mode-line-format* (list
																 "["
																 '(:eval (RUN-SHELL-COMMAND "date '+%F %H:%M'|tr -d [:cntrl:]" T)) "] "
																 "[%n] "
																 " %w ^> "
																 "[%D]"
																 "[%M]"
																 "[%m]"
																 " [tay@%h] "
																 "%T"))


