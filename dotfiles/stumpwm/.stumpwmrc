(define-key *top-map* (kbd "A-M") '*mpd-map*)


(setf *disk-usage-paths* (list "/" "/mnt/nas"))
;;; modeline 
(setf *mode-line-background-color* "#000"
      *mode-line-foreground-color* "#aaa"
      *mode-line-border-color* "#aa5500"
      *mode-line-timeout* 5
      *mode-line-border-width* 1
      *mode-line-pad-x* 1
      *mode-line-pad-y* 1)
(setf *screen-mode-line-format* (list "[" '(:eval (RUN-SHELL-COMMAND "date '+%F %H:%M'|tr -d [:cntrl:]" T)) "] [%n]  %w ^> [%D][%M][%m] [tay@%h] %T"))

;; Turn on the mode-line for every head so the %T tray placeholder above
;; actually has a window to attach to.  new-mode-line-hook (registered
;; via stumptray:add-mode-line-hooks) fires here and creates the tray.
;; On reinit the mode-line already exists, so the hook is a no-op; we
;; then walk the screens and attach a tray manually where one is missing.
(dolist (screen *screen-list*)
  (dolist (head (screen-heads screen))
    (unless (head-mode-line head)
      (toggle-mode-line screen head)))
  (unless (stumptray::screen-tray screen)
    (let ((ml (some (lambda (head) (head-mode-line head))
                    (screen-heads screen))))
      (when ml
        (stumptray::new-mode-line-hook ml)))))


;; Web jump (works for DuckDuckGo and Imdb)
(defmacro make-web-jump (name prefix)
  `(defcommand ,(intern name) (search) ((:rest ,(concatenate 'string name " search: ")))
     (nsubstitute #\+ #\Space search)
     (run-shell-command (concatenate 'string ,prefix search))))

(make-web-jump "duckduckgo" "firefox https://duckduckgo.com/?q=")
(make-web-jump "imdb" "firefox http://www.imdb.com/find?q=")

;; C-t M-s is a terrble binding, but you get the idea.
(define-key *root-map* (kbd "M-s") "duckduckgo")
(define-key *root-map* (kbd "i") "imdb")

;; Message/input/modeline font.  StumpWM's built-in renderer uses legacy
;; core-X fonts, not fontconfig/Xft.  Use unscii only when the X server can
;; actually open it; otherwise fall back rather than breaking config reloads.
(defparameter *tay-unscii-font-dir*
  (namestring (merge-pathnames ".local/share/fonts/unscii/"
                               (user-homedir-pathname))))
(defparameter *tay-digital-font-dir*
  (namestring (merge-pathnames ".local/share/fonts/digital/pcf/"
                               (user-homedir-pathname))))
(defparameter *tay-unscii-core-fonts*
  '("-unscii-unscii-medium-r-normal-full-16-160-75-75-c-80-iso10646-1"
    "-*-unscii-medium-r-*-full-16-*-*-*-*-*-iso10646-*"))
(defparameter *tay-fallback-core-font*
  "-digital-vt220-medium-r-normal-80col-20-200-75-75-*-100-iso10646-1")

(defun tay-add-core-font-dir (dir)
  "Add DIR to the X core font path, ignoring failures outside X sessions."
  (when (probe-file dir)
    (run-shell-command
     (format nil "xset +fp ~s >/dev/null 2>&1; xset fp rehash >/dev/null 2>&1"
             dir)
     t)))

(defun tay-try-set-font (font)
  "Try FONT for StumpWM, returning NIL instead of signaling CLX font errors."
  (handler-case
      (set-font font)
    (xlib:font-error () nil)
    (xlib:invalid-font () nil)
    (error () nil)))

(tay-add-core-font-dir *tay-digital-font-dir*)
(tay-add-core-font-dir *tay-unscii-font-dir*)
(unless (some #'tay-try-set-font *tay-unscii-core-fonts*)
  (tay-try-set-font *tay-fallback-core-font*))


;;; Define window placement policy...

;; Clear rules
(clear-window-placement-rules)

;;; style

;;; border size
(setf *maxsize-border-width* 1)
(setf *normal-border-width* 1)
(setf *transient-border-width* 1)
(setf *window-border-style* :tight)
;;; border colors
(set-focus-color "#00aa00")
(set-win-bg-color "#000000")
(set-unfocus-color "#333333")
(set-float-focus-color "#aa00aa")
(set-float-unfocus-color "#a00")

;;; locations of things
(setf *message-window-gravity* :bottom)
(setf *input-window-gravity* :bottom)
(set-normal-gravity :center)
(set-maxsize-gravity :center)
(set-transient-gravity :center)
(gravity :center)

;; message window style
(set-bg-color "#000")
(set-border-color "#aa00aa")



