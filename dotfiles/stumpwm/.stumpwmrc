;; -*-lisp-*-
;;
;; Here is a sample .stumpwmrc file

(in-package :stumpwm)

;; Ensure Quicklisp is available before any ql:quickload forms below.
(unless (find-package :ql)
  (let ((quicklisp-init (merge-pathnames "quicklisp/setup.lisp"
                                         (user-homedir-pathname))))
    (when (probe-file quicklisp-init)
      (load quicklisp-init))))

;; Per-host fragment — sourced early so it can set *module-dir* and other
;; load-path tweaks before the rest of this file calls (load-module ...).
(let ((host-file (merge-pathnames
                  (format nil ".stumpwm.d/host-~a.lisp" (machine-instance))
                  (user-homedir-pathname))))
  (when (probe-file host-file)
    (load host-file)))

;; (run-shell-command "emacs --daemon")

;; change the prefix key to something else
(set-prefix-key (kbd "A-x"))

;; Preferred terminal emulator.  Used by the ssh binding and the
;; app-launcher below for "run this inside a terminal"; ghostty's
;; `-e <command>' flag mirrors xterm's, so call sites are interchangeable.
(defvar *terminal-program* "ghostty")

;; (ql:quickload :slynk)
;; prompt the user for an interactive command. The first arg is an
;; optional initial contents.
(defcommand colon1 (&optional (initial "")) (:rest)
  (let ((cmd (read-one-line (current-screen) ": " :initial-input initial)))
    (when cmd
      (eval-command cmd t))))

;;; Vertico/Ivy/Helm-style completion for StumpWM prompts.
(defparameter *tay-completion-menu-height* 20)

(defun tay-whitespace-char-p (char)
  (find char " \t\n\r"))

(defun tay-string-blank-p (string)
  (every #'tay-whitespace-char-p string))

(defun tay-first-line (string)
  (let ((end (position #\Newline string)))
    (subseq string 0 end)))

(defun tay-ellipsize (string width)
  (if (> (length string) width)
      (concatenate 'string (subseq string 0 (max 0 (- width 1))) "…")
      string))

(defun tay-command-menu-label (command-name)
  "Return COMMAND-NAME with a short doc annotation for command menus."
  (let* ((command (get-command-structure command-name))
         (doc (and command (documentation (command-name command) 'function))))
    (if (and doc (not (tay-string-blank-p doc)))
        (format nil "~A  —  ~A" command-name (tay-ellipsize (tay-first-line doc) 80))
        command-name)))

(defun tay-completion-object-string (object)
  (etypecase object
    (string object)
    (symbol (string-downcase object))
    (character (string object))
    (t (princ-to-string object))))

(defun tay-completion-label (object &key command-labels)
  (let ((string (tay-completion-object-string object)))
    (if command-labels
        (tay-command-menu-label string)
        string)))

(defun tay-completion-entries (completions &key initial-input command-labels)
  "Return menu entries of the form (LABEL VALUE) for static COMPLETIONS."
  (let* ((prefix (and initial-input (string-trim " " initial-input)))
         (objects (if (and prefix (plusp (length prefix)))
                      (remove-if-not (lambda (object)
                                       (search prefix
                                               (tay-completion-object-string object)
                                               :test #'char-equal))
                                     completions)
                      completions)))
    (mapcar (lambda (object)
              (list (tay-completion-label object :command-labels command-labels)
                    (tay-completion-object-string object)))
            objects)))

(defun tay-menu-completing-read (screen prompt completions
                                 &key (initial-input "") require-match command-labels)
  "Read a completion using StumpWM's vertical filtering menu.

This is for static completion lists.  Dynamic completers such as shell
program completion still use StumpWM's original one-line completion so
TAB-style dynamic expansion keeps working."
  (if (listp completions)
      (let* ((*menu-maximum-height* *tay-completion-menu-height*)
             (entries (tay-completion-entries completions
                                               :initial-input initial-input
                                               :command-labels command-labels))
             (selection (and entries
                             (select-from-menu screen entries prompt))))
        (cond (selection (second selection))
              (require-match nil)
              ((and initial-input (plusp (length initial-input))) initial-input)
              (t nil)))
      (tay-original-completing-read screen prompt completions
                                    :initial-input initial-input
                                    :require-match require-match)))

(unless (fboundp 'tay-original-completing-read)
  (setf (symbol-function 'tay-original-completing-read)
        (symbol-function 'completing-read)))

(defun completing-read (screen prompt completions &key (initial-input "") require-match)
  "Use vertical completion menus for static completion prompts."
  (tay-menu-completing-read screen prompt completions
                            :initial-input initial-input
                            :require-match require-match))

(defun tay-command-line-has-arguments-p (input)
  "Return true when INPUT contains a command plus non-blank argument text."
  (let* ((trimmed (string-trim " " (or input "")))
         (space (position-if #'tay-whitespace-char-p trimmed)))
    (and space (not (tay-string-blank-p (subseq trimmed space))))))

(defcommand colon (&optional initial-input) (:rest)
  "Read a StumpWM command using a vertical filtering menu, then run it.

This keeps the normal colon command behavior of invoking interactive
StumpWM commands, but replaces the one-line TAB completion UI with the
built-in StumpWM menu: type to filter, use C-n/C-p or Up/Down to move,
RET to run, and C-g/ESC to abort.  If INITIAL-INPUT already contains a
full command line with arguments, fall back to the raw command prompt so
it can still be edited before evaluation."
  (let ((initial (or initial-input "")))
    (cond
      ((tay-command-line-has-arguments-p initial)
       (let ((cmd (read-one-line (current-screen) ": " :initial-input initial)))
         (unless cmd
           (throw 'error :abort))
         (when (plusp (length cmd))
           (eval-command cmd t))))
      (t
       (let ((cmd (tay-menu-completing-read (current-screen) "M-x:" (all-commands)
                                            :initial-input initial
                                            :require-match t
                                            :command-labels t)))
         (unless cmd
           (throw 'error :abort))
         (eval-command cmd t))))))

(defun tay-screen-windows (&optional (screen (current-screen)))
  "Return all unique windows on SCREEN, across all groups."
  (let (windows)
    (dolist (group (screen-groups screen) (nreverse windows))
      (dolist (window (group-windows group))
        (pushnew window windows :test #'eq)))))

(defun tay-global-window-label (window)
  "Return a menu label for WINDOW including its group and class."
  (let ((group (window-group window)))
    (format nil "[~A:~A] #~A ~A~@[  —  ~A~]"
            (group-map-number group)
            (group-name group)
            (window-number window)
            (window-name window)
            (window-class window))))

(defun tay-global-window-entries ()
  "Return menu entries of the form (LABEL WINDOW) for all windows."
  (mapcar (lambda (window)
            (list (tay-global-window-label window) window))
          (sort (tay-screen-windows)
                #'string-lessp
                :key #'tay-global-window-label)))

(defcommand (pull-global-window tile-group) () ()
  "Select a window from any group and pull it into the current frame."
  (let* ((*menu-maximum-height* *tay-completion-menu-height*)
         (entries (tay-global-window-entries))
         (selection (and entries
                         (select-from-menu (current-screen) entries "Pull window:"))))
    (cond
      ((null entries)
       (message "No windows."))
      (selection
       (let ((window (second selection))
             (target-group (current-group))
             (target-frame (tile-group-current-frame (current-group))))
         (unless (eq (window-group window) target-group)
           (move-window-to-group window target-group))
         (pull-window window target-frame)
         (message "Pulled: ~A" (window-name window))))
      (t
       (throw 'error :abort)))))

