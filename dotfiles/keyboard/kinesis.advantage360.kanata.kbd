#| --------------------------------------------------------------------------

                         kanata: Kinesis Advantage 360

   Active host: basedserv. Bound to the Adv360 evdev node via `linux-dev'
   below; `kb_setup.sh' picks this file when $HOSTNAME == basedserv.

   The `defsrc' layer below mirrors the Advantage 360's physical layout
   (split halves + thumb clusters). Copy a `deflayer' template to add a
   new layer with matching `transparent' buttons (`_').

(deflayer name
  _    _    _    _                             _    _    _    _    _    _    _
       _    _    _    _    _    _    _    _    _    _    _    _         _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _         _
  _    _    _    _    _    _    _    _    _    _    _    _    _         _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _              _
  _    _    _    _              _              _    _    _         _    _    _
                                                                   _    _    _
)

layout: {zmk_keyboard: adv360}
  -------------------------------------------------------------------------- |#


;; (deflocalkeys-sun
;;   F18 247
;; 	F19 138
;; 	F20 248
;; 	F21 142)
;; US
(defsrc
  =      1    2    3    4    5    			        6    7    8    9    0    -  
  tab    q    w    e    r    t F18          F20 y    u    i    o    p     \
  esc    a    s    d    f    g F19          F21 h    j    k    l    ;     ' 
  lshift z    x    c    v    b                  n    m    ,    .    /     rshift
	       grv  caps left right                   up   down [    ]

             lctl  lalt                rmet rctl
						       home                pgup
        bspc del   end                 pgdn ent spc
 																																	 
)

;; press both to latch?
(defalias
  ;; homerow mod
  Sf (tap-hold-release 200 200 f lshift)       ;; left homerow shift
  Cd (tap-hold-release 200 200 d lctl)         ;; left homerow ctrl
  Ms (tap-hold-release 200 200 s lalt)         ;; left homerow meta
  sa (tap-hold-release 250 250 a lmet)         ;; left homehow super
  Sj (tap-hold-release 200 200 j lshift)       ;; right homerow shift
  Ck (tap-hold-release 200 200 k lctl)         ;; right homerow ctrl
  Ml (tap-hold-release 200 200 l lalt)         ;; right homerow meta
  s; (tap-hold-release 200 200 ; lmet)         ;; right homerow super
  Hro (tap-hold-release 200 200 bspc ralt)     ;; left thumb alt
  Hsp (tap-hold-release 200 200 spc  ralt)     ;; right thumb alt
;;  Tr (tap-next-release r (layer-toggle top))         ;; left homerow top
;;  Tu (tap-next-release u (layer-toggle top))         ;; right homerow super
  ;; other mod keys
  eoam (tap-hold-release 200 200 esc rmet)    ;; escape / hyper mode
  qoam (tap-hold-release 200 200 ' rmet)       ;; quote / hyper mode
  osft (tap-hold-release 200 200 0 lshift)    ;; open round / shift
  csft (tap-hold-release 200 200 0 rshift)    ;; close round / shift

  ;; greek
	gr  (arbitrary-code 85) ;; modeswitch
	top (arbitrary-code 84) ;; iso level 3
	rtop (tap-hold-release 200 200 ent @top)
	gdel (tap-hold-release 200 200 del @gr)

  ;; Space Cadet command keysyms (emitted via spare evdev keycodes;
  ;; the XKB layout maps each keycode to the actual command keysym).
	sc-macro       (arbitrary-code 112) ;; -> XF86Tools
	sc-terminal    (arbitrary-code 200) ;; -> XF86Terminal
	sc-quote       (arbitrary-code 201) ;; -> Multi_key
	sc-overstrike  (arbitrary-code 202) ;; -> Insert
	sc-clearinput  (arbitrary-code 203) ;; -> Clear
	sc-clearscreen (arbitrary-code 204) ;; -> XF86Reload
	sc-holdoutput  (arbitrary-code 205) ;; -> Pause
	sc-stopoutput  (arbitrary-code 206) ;; -> XF86Stop
	sc-abort       (arbitrary-code 207) ;; -> Cancel
	sc-break       (arbitrary-code 208) ;; -> Break
	sc-system      (arbitrary-code 209) ;; -> XF86Setup
	sc-network     (arbitrary-code 210) ;; -> XF86RotateWindows
	sc-altmode     (arbitrary-code 211) ;; -> ISO_Group_Latch
	sc-modelock    (arbitrary-code 212) ;; -> ISO_Group_Lock
	sc-resume      (arbitrary-code 213) ;; -> XF86AudioPlay
	sc-status      (arbitrary-code 214) ;; -> XF86Display
	sc-line        (arbitrary-code 215) ;; -> Linefeed
	sc-help        (arbitrary-code 138) ;; KEY_HELP -> Help
)

(defchordsv2
  (q w)       @sc-macro       100 first-release ()
  (w e)       @sc-terminal    100 first-release ()
  (e r)       @sc-quote       100 first-release ()
  (r t)       @sc-overstrike  100 first-release ()
  (t y)       @sc-clearinput  100 first-release ()
  (y u)       @sc-clearscreen 100 first-release ()
  (u i)       @sc-holdoutput  100 first-release ()
  (i o)       @sc-stopoutput  100 first-release ()
  (o p)       @sc-abort       100 first-release ()
  (p \)       @sc-break       100 first-release ()
  (s d)       @sc-system      100 first-release ()
  (x c)       @sc-network     100 first-release ()
  (menu left) @sc-altmode     100 first-release ()
  (grv menu)  @sc-modelock    100 first-release ()
  (k l)       @sc-resume      100 first-release ()
  (, .)       @sc-status      100 first-release ()
  (l ;)       @sc-help        100 first-release ()
  (h j)       @sc-line        100 first-release ()
)
(deflayer normal
  =      1    2    3    4    5    	    		6    7    8    9    0    -  
  tab    q    w    e    r    t F18      F20 y    u    i    o    p     \
  @eoam  @sa  @Ms  @Cd  @Sf  g F19      F21 h    @Sj  @Ck  @Ml  @s;   @qoam
  lshift z    x    c    v    b              n    m    ,    .    /     rshift
	       grv  caps left right               up   down [    ]

                  @gr   lrld                rmet  @top
		     			          home                pgup
             @Hro @gdel end                 pgdn  @rtop @Hsp
)
;;(deflayer modelatch)
;; (deflayer greek
;;   esc  mute vold volu                          prnt slck pause home end ins del  
;;         f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12     
;;   grv   1    2    3    4    5    6    7    8    9    0    -     =        bspc
;;   tab   q    w    e    r    t    y    u    i    o    p    [     ]        \
;;   @roam @sa  @Ms  @Cd  @Sf  g    h    @Sj  @Ck  @Ml  @s;  @qoam          ret
;;   @osf  z    x    c    v    b    n    m    ,    .    /                  @csft
;;   wkup  lctl lmet lalt           spc            ralt cmps rctl      pgup up   pgdn
;;                                                                    left down rght
;; )
;;(deflayer top)
(defcfg
    linux-dev /dev/input/by-id/usb-Kinesis_Kinesis_Adv360_360555127546-if01-event-kbd
    process-unmapped-keys yes
    concurrent-tap-hold yes)

