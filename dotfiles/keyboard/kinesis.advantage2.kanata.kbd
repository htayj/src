;; (deflocalkeys-sun
;;   F18 247
;; 	F19 138
;; 	F20 248
;; 	F21 142)
;; US
(defsrc
  =      1    2    3    4    5    			        6    7    8    9    0    -  
  tab    q    w    e    r    t                  y    u    i    o    p     \
  esc    a    s    d    f    g                  h    j    k    l    ;     ' 
  lshift z    x    c    v    b                  n    m    ,    .    /     rshift
	       grv  menu left right                   up   down [    ]

             lctl  lalt                rmet rctl
						       home                pgup
        bspc del   end                 pgdn ent spc
 																																	 
)

;; press both to latch?
(defalias
  ;; homerow mod
  Sf (tap-hold-release 200 200 f lshift)       ;; left homerow shift
  Cd (tap-hold-release 200 200 d lctl)         ;; left homerow ctrl
  Ms (tap-hold-release 200 200 s lalt)         ;; left homerow meta
  sa (tap-hold-release 250 250 a lmet)         ;; left homehow super
  Sj (tap-hold-release 200 200 j lshift)       ;; right homerow shift
  Ck (tap-hold-release 200 200 k lctl)         ;; right homerow ctrl
  Ml (tap-hold-release 200 200 l lalt)         ;; right homerow meta
  s; (tap-hold-release 200 200 ; lmet)         ;; right homerow super
  Hro (tap-hold-release 200 200 bspc rmet)     ;; left thumb hyper
  Hsp (tap-hold-release 200 200 spc  rmet)     ;; right thumb hyper
;;  Tr (tap-next-release r (layer-toggle top))         ;; left homerow top
;;  Tu (tap-next-release u (layer-toggle top))         ;; right homerow super
  ;; other mod keys
  eoam (tap-hold-release 200 200 esc ralt)    ;; escape / alt mode
  qoam (tap-hold-release 200 200 ' ralt)       ;; quote / alt mode
  osft (tap-hold-release 200 200 0 lshift)    ;; open round / shift
  csft (tap-hold-release 200 200 0 rshift)    ;; close round / shift

  ;; greek
	gr  (arbitrary-code 85) ;; modeswitch
	top (arbitrary-code 84) ;; iso level 3
	rtop (tap-hold-release 200 200 ent @top)
	gdel (tap-hold-release 200 200 del @gr)
)
(deflayer normal
  =      1    2    3    4    5    	    		6    7    8    9    0    -  
  tab    q    w    e    r    t              y    u    i    o    p     \
  @eoam  @sa  @Ms  @Cd  @Sf  g              h    @Sj  @Ck  @Ml  @s;   @qoam
  lshift z    x    c    v    b              n    m    ,    .    /     rshift
	       grv  menu left right               up   down [    ]

                  @gr   lrld                rmet  @top
		     			          home                pgup
             @Hro @gdel end                 pgdn  @rtop @Hsp
)
;;(deflayer modelatch)
;; (deflayer greek
;;   esc  mute vold volu                          prnt slck pause home end ins del  
;;         f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12     
;;   grv   1    2    3    4    5    6    7    8    9    0    -     =        bspc
;;   tab   q    w    e    r    t    y    u    i    o    p    [     ]        \
;;   @roam @sa  @Ms  @Cd  @Sf  g    h    @Sj  @Ck  @Ml  @s;  @qoam          ret
;;   @osf  z    x    c    v    b    n    m    ,    .    /                  @csft
;;   wkup  lctl lmet lalt           spc            ralt cmps rctl      pgup up   pgdn
;;                                                                    left down rght
;; )
;;(deflayer top)
(defcfg
   linux-dev /dev/input/by-id/usb-Kinesis_Advantage2_Keyboard_314159265359-if01-event-kbd
    process-unmapped-keys yes)

