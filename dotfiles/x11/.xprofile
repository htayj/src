# Shared X session setup.
# SDDM's Xsession sources ~/.xprofile; ~/.xinitrc sources it too.

# Add bitmap/core-X font dirs when present. These are needed by legacy X core
# font clients such as StumpWM's built-in renderer and xterm XLFD fallbacks.
[ -d "$HOME/.local/share/fonts/digital/bdf" ] && xset +fp "$HOME/.local/share/fonts/digital/bdf/"
[ -d "$HOME/.local/share/fonts/digital/pcf" ] && xset +fp "$HOME/.local/share/fonts/digital/pcf/"
[ -d "$HOME/.local/share/fonts/unscii" ]      && xset +fp "$HOME/.local/share/fonts/unscii/"
xset fp rehash >/dev/null 2>&1 || true

# User-level XKB layout converted from ~/.Xmodmap. This keeps the Space Cadet
# Greek/APL layer on the old Mode_switch key and the top/math layer on the old
# ISO_Level3_Shift key, without installing anything under /usr/share/X11/xkb.
if [ -n "${DISPLAY:-}" ] && [ -r "$HOME/.config/xkb/keymap/spacecadet.xkb" ] && command -v xkbcomp >/dev/null 2>&1; then
    xkbcomp -I"$HOME/.config/xkb" -w 0 "$HOME/.config/xkb/keymap/spacecadet.xkb" "$DISPLAY" >/dev/null 2>&1 || true
fi
