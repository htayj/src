# Shared X session setup.
# SDDM's Xsession sources ~/.xprofile; ~/.xinitrc sources it too.

if [ -d "$HOME/.guix-home/profile/bin" ]; then
    PATH="$HOME/.guix-home/profile/bin:$PATH"
    export PATH
fi

# Xorg rejects the Stow-created symlink-only font directories, so use the
# source directories containing the actual bitmap files and indexes.
font_root="$HOME/src/dotfiles/x11/.local/share/fonts"
for font_dir in "$font_root/digital/bdf" "$font_root/digital/pcf" "$font_root/unscii"; do
    [ -d "$font_dir" ] || continue
    xset -fp "$font_dir" >/dev/null 2>&1 || true
    xset +fp "$font_dir"
done
xset fp rehash >/dev/null 2>&1 || true
xsetroot -cursor_name left_ptr
unset font_dir font_root

# User-level XKB layout converted from ~/.Xmodmap. This keeps the Space Cadet
# Greek/APL layer on the old Mode_switch key and the top/math layer on the old
# ISO_Level3_Shift key, without installing anything under /usr/share/X11/xkb.
if [ -n "${DISPLAY:-}" ] && [ -r "$HOME/.config/xkb/keymap/spacecadet.xkb" ]; then
    if command -v xkbcomp >/dev/null 2>&1; then
        xkbcomp -I"$HOME/.config/xkb" -w 0 "$HOME/.config/xkb/keymap/spacecadet.xkb" "$DISPLAY" >/dev/null 2>&1 ||
            printf '%s\n' 'Failed to load the Space Cadet XKB map.' >&2
    else
        printf '%s\n' 'xkbcomp is unavailable; the Space Cadet XKB map was not loaded.' >&2
    fi
fi

# Hand the live X environment to the systemd --user instance so any user-level
# graphical service (dunst, etc.) can see DISPLAY/XAUTHORITY.
#
# picom is intentionally NOT started here: it was causing visible lag and has
# been disabled. To re-enable, uncomment the `systemctl --user start
# picom.service` line below and `systemctl --user enable picom.service`.
if [ -n "${DISPLAY:-}" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment DISPLAY XAUTHORITY
    # systemctl --user start picom.service   # disabled — compositor lag
fi
