# Shared X session setup.
# SDDM's Xsession sources ~/.xprofile; ~/.xinitrc sources it too.

# Use the workstation Guix Home profile explicitly.  Display-manager sessions
# do not reliably inherit GUIX_PROFILE, and falling through to the system or
# legacy ~/.guix-profile tools gives XKB/StumpWM mismatched dependencies.
GUIX_PROFILE="$HOME/.guix-home/profile"
export GUIX_PROFILE
if [ -d "$GUIX_PROFILE/bin" ]; then
    PATH="$GUIX_PROFILE/bin:$PATH"
    export PATH
fi

# basedbox: Odyssey on DP, CRT below its right side. Keep other hosts unchanged.
# Run in a subshell so positional arguments and helpers do not leak to Xsession.
if [ -n "${DISPLAY:-}" ] && [ "$(hostname)" = basedbox ]; then
    (
        outputs=$(xrandr --query) || exit
        set --
        crt_position=0x0
        case "$outputs" in
            *"DisplayPort-0 connected"*)
                set -- --output DisplayPort-0 --primary --mode 5120x1440 \
                    --rate 119.98 --pos 0x0 --rotate normal --scale 1x1
                crt_position=4200x1440
                ;;
        esac
        case "$outputs" in
            *"HDMI-A-0 connected"*)
                set -- "$@" --output HDMI-A-0 --mode 800x600 --rate 75 \
                    --pos "$crt_position" --rotate normal --scale 1x1
                [ "$crt_position" != 0x0 ] || set -- "$@" --primary
                ;;
        esac
        [ "$#" -eq 0 ] || xrandr "$@"
    ) || printf '%s\n' 'Failed to apply the basedbox monitor layout.' >&2
fi

# Xorg rejects the Stow-created symlink-only font directories, so use the
# source directories containing the actual bitmap files and indexes.
font_root="$HOME/src/dotfiles/x11/.local/share/fonts"
for font_dir in "$font_root/digital/bdf" "$font_root/digital/pcf" "$font_root/unscii"; do
    [ -d "$font_dir" ] || continue
    xset -fp "$font_dir" >/dev/null 2>&1 || true
    xset +fp "$font_dir"
done

# Bitmap fonts from the Guix home profile (CADR, Genera, DEC). The profile
# exposes each font as a symlink, and the intermediate fonts-dir union is
# symlinked too, so Xorg rejects both. Resolve each fonts.dir to the real
# package output, which holds regular files, and add the deduplicated set.
profile_fonts="$HOME/.guix-home/profile/share/fonts"
if [ -d "$profile_fonts" ]; then
    find -L "$profile_fonts" -name fonts.dir -print 2>/dev/null \
        | while read -r index; do readlink -f "$(dirname "$index")/$(head -2 "$index" | tail -1 | cut -d' ' -f1)"; done \
        | xargs -r -n1 dirname 2>/dev/null | sort -u \
        | while read -r font_dir; do
            [ -d "$font_dir" ] || continue
            xset -fp "$font_dir" >/dev/null 2>&1 || true
            xset +fp "$font_dir" >/dev/null 2>&1 || true
        done
fi

xset fp rehash >/dev/null 2>&1 || true
xsetroot -cursor_name left_ptr
unset font_dir font_root profile_fonts

# Load the user-level Space Cadet XKB layout before StumpWM starts.  Use the
# shared helper rather than xkbcomp alone: the compiled map contains inherited
# modifier assignments which must be normalized with xmodmap before StumpWM
# snapshots the modifier map and grabs its Alt bindings.
spacecadet_reload="$HOME/manna-cadet/reload-spacecadet-xkb.sh"
spacecadet_keymap="$HOME/.config/xkb/keymap/spacecadet.xkb"
if [ -n "${DISPLAY:-}" ] && [ -x "$spacecadet_reload" ] && [ -r "$spacecadet_keymap" ]; then
    "$spacecadet_reload" "$spacecadet_keymap" "$HOME/.config/xkb" ||
        printf '%s\n' 'Failed to load the Space Cadet XKB map.' >&2
fi

# Hand the live X environment to the systemd --user instance so any user-level
# graphical service (dunst, etc.) can see DISPLAY/XAUTHORITY.
#
# picom is intentionally NOT started here: it was causing visible lag and has
# been disabled. To re-enable, uncomment the `systemctl --user start
# picom.service` line below and `systemctl --user enable picom.service`.
if [ -n "${DISPLAY:-}" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment DISPLAY XAUTHORITY
    # systemctl --user start picom.service   # disabled — compositor lag
fi
