! see also /usr/share/X11/app-deafaults/XTerm
! ========= default font =========
! xterm*font:     -digital-vt220-medium-r-normal-80col-*-*-*-*-*-*-iso10646-1
! xterm*wideFont: -digital-vt220-medium-r-wide-80col-*-*-*-*-*-*-iso10646-1

! TODO not sure what this does?
! xterm*wideChars: true

! ========= alternative fonts =========
*fontMenu*fontdefault*Label: UNSCII 16
! Prefer Xft/fontconfig so package-manager-installed OTF/TTF fonts are usable
! without manually adding legacy core-X font paths with `xset fp`.
XTerm*renderFont: true
XTerm*faceName: unscii:style=16-full:pixelsize=16:antialias=false
! Keep the XLFD/core-font resources as fallback/menu entries for hosts that
! install bitmap fonts into the X server font path.
*VT100.font: -*-unscii-medium-r-*-full-16-*-*-*-*-*-iso10646-*
! *VT100.wideFont: -digital-vt220-medium-r-wide-80col-20-200-75-75-c-200-iso10646-1
! *VT100.wideFont: -digital-vt220-medium-r-wide-80col-20-*-*-*-*-*-iso10646-1
*VT100.wideFont: -*-unifont-medium-r-*-*-*-*-*-*-*-*-iso10646-*

*fontMenu*font1*Label: vt220_40pt
*VT100.font1: -digital-vt220-medium-r-normal-80col-40-*-*-*-*-*-iso10646-1

*fontMenu*font2*Label: DEC VT220 80col 10x20
*VT100.font2: -digital-vt220-medium-r-normal-80col-20-200-75-75-c-100-iso10646-1

*fontMenu*font3*Label: unifont
*VT100.font3: -gnu-unifont-medium-r-*-*-16-*-*-*-*-*-iso10646-*
*fontMenu*font4*Label: unscii-tall
*VT100.font4: -*-unscii-medium-r-normal-tall-16-*-*-*-*-*-iso10646-*
*fontMenu*font5*Label: unscii-square
*VT100.font5: -*-unscii-medium-r-normal-*-8-*-*-*-*-*-iso10646-*
*fontMenu*font6*Label: unscii-square-large
*VT100.font6: -*-unscii-medium-r-normal-*-17-*-*-*-*-*-iso10646-*

! === exp ===

! ========= key behavior =========
XTerm.vt100.backarrowKey: false
XTerm.ttyModes: erase ^?
XTerm.vt100.saveLines: 4096
XTerm.vt100.metaSendsEscape: true

! ========= scrollbar =========
! Off — tmux history-limit covers scrollback, mouse-wheel works in tmux.
XTerm.vt100.scrollBar: false

! colors
*background: rgb:00/00/00
*foreground: #aaaaaa
xterm*color0: #000000
xterm*color1: #aa0000
xterm*color2: #00aa00
xterm*color3: #aa5500
xterm*color4: #0000aa
xterm*color5: #aa00aa
xterm*color6: #00aaaa
xterm*color7: #aaaaaa
xterm*color8: #555555
xterm*color9: #ff5555
xterm*color10: #55ff55
xterm*color11: #ffff55
xterm*color12: #5555ff
xterm*color13: #ff55ff
xterm*color14: #55ffff
xterm*color15: #ffffff

! enable sixel
xterm*decTerminalID: 340

! ========= modifyOtherKeys =========
! xterm sends distinct CSI u sequences for Ctrl+<digit>, Ctrl+Shift+<letter>,
! and other modifier combos that the legacy CSI table cant represent.
! Emacs uses these for `C-(`, `C-,`, `C-1` argument prefixes etc.
! Level 1 is the conservative setting; level 2 is more aggressive
! (sends sequences for everything ctrl/shifted).
XTerm.vt100.modifyOtherKeys: 1

! ========= clipboard: Ctrl-Shift-C / Ctrl-Shift-V =========
! Default xterm copy/paste is middle-click (selection) and Shift+Ins
! (clipboard). Add the GUI-conventional Ctrl-Shift-C / Ctrl-Shift-V
! bindings on top. The #override prefix layers ours on the built-in
! translation table rather than replacing it, so default mouse
! selection / Shift-Ins still work.
XTerm.vt100.translations: #override \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD)

! Make new selections land on the CLIPBOARD selection (not just PRIMARY)
! so Ctrl-Shift-V actually has something to paste after a drag-select.
XTerm.vt100.selectToClipboard: true

! fontDoublesize (class FontDoublesize)
