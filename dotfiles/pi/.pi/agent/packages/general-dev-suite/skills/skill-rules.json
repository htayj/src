    "task-graph-autoimprove-loop": {
      "priority": "high",
      "description": "Continue task graph autoimprove loops safely; for explicit extension-bridge iterations, keep bridge guidance read-only and evidence-driven.",
      "promptTriggers": {
        "keywords": [
          "continue autoimprove",
          "autoimprove loop",
          "next autoimprove iteration",
          "keep autoimproving"
        ],
        "intentPatterns": [
          "\\bcontinue\\s+(?:the\\s+)?autoimprove\\b",
          "\\bautoimprove\\b.*\\b(iteration|loop|again)\\b",
          "(?:^|[.!?;:]\\s*)(?:please\\s+)?(?:call|use|run|invoke|preview|create)\\s+task_graph_continue_autoimprove\\b",
          "\\btask_graph_continue_autoimprove\\b.*\\b(next|linked|iteration|successor|preview|create)\\b",
          "\\b(autoimprove|successor|next iteration|continuation)\\b.*\\b(future loop queue|root work queue|future work queue|future root work|queued successor)\\b",
          "\\b(future loop queue|root work queue|future work queue|future root work|queued successor)\\b.*\\b(autoimprove|successor|next iteration|continuation)\\b",
          "\\b(autoimprove|iteration|continuation|successor|loop)\\b.*\\b(task_graph_extension_guide|extension workflow bridge|extension guide|before-agent advisory|generated task prompt hints|read[- ]?only task[-_ ]?graph extension guidance)\\b",
