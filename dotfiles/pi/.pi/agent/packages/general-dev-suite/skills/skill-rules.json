{
  "skills": {
    "tdd": {
      "priority": "high",
      "description": "Use TDD for behavior-changing implementation work.",
      "promptTriggers": {
        "keywords": [
          "implement",
          "fix",
          "add",
          "change behavior",
          "bug",
          "feature"
        ],
        "intentPatterns": [
          "\\b(write|add|update).*test",
          "\\bbug\\b"
        ]
      }
    },
    "build-test-procedures": {
